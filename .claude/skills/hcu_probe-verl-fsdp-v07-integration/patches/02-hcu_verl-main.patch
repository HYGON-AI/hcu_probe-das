diff --git a/hcu_verl/trainer/constants_ppo.py b/hcu_verl/trainer/constants_ppo.py
index 1bba4f4..847f293 100644
--- a/hcu_verl/trainer/constants_ppo.py
+++ b/hcu_verl/trainer/constants_ppo.py
@@ -58,7 +58,23 @@ PPO_RAY_RUNTIME_ENV = {
         "GLOG_minloglevel": "3",
         "GPU_MAX_HW_QUEUES": "10",
         "HIP_VISIBLE_DEVICES": "0,1,2,3,4,5,6,7",
+        "RAY_EXPERIMENTAL_NOSET_HIP_VISIBLE_DEVICES": "1",
+        "RAY_EXPERIMENTAL_NOSET_CUDA_VISIBLE_DEVICES": "1",
+        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
+        "HSA_NO_SCRATCH_RECLAIM": "1",
+        "HSA_FORCE_FINE_GRAIN_PCIE": "1",
+        "HIP_FORCE_DEV_KERNARG": "1",
         "RAY_ACCEL_ENV_VAR_OVERRIDE_ON_ZERO": "0",
+        # hcu_probe 训推 dump:从 driver 透传到 ray worker(FSDPEngine._ensure_debugger 在 worker 进程读)
+        "DUMP_ON": os.getenv("DUMP_ON", "0"),
+        "DUMP_PHASE": os.getenv("DUMP_PHASE", "log_prob"),
+        "DUMP_ACTOR_CONFIG": os.getenv("DUMP_ACTOR_CONFIG", "/data/hcu_probe_verl/config_actor.json"),
+        # 推理侧 ② vllm worker(也是 ray worker)读 DUMP_CONFIG_PATH 建 debugger;空字符串则不 dump
+        "DUMP_CONFIG_PATH": os.getenv("DUMP_CONFIG_PATH", ""),
+        # async dump 文档要求关 torchdynamo(避免训练侧编译影响 dump 数值);shell export 到不了 worker,须透传
+        "TORCHDYNAMO_DISABLE": os.getenv("TORCHDYNAMO_DISABLE", "0"),
+        # hcu_probe monitor:dp_actor._ensure_monitor 在 actor worker 进程读 MONITOR_CONFIG 建 TrainerMonitorV2;空则不 monitor
+        "MONITOR_CONFIG": os.getenv("MONITOR_CONFIG", ""),
     },
 }
 
