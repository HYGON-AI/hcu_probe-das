+            self._update_actor_logger_fp = open(log_dir / "update_actor_log.jsonl", "a")
+        except Exception as e:
+            logger.warning(f"Failed to initialize update_actor_logger: {e}")
+
+    def _log_update_actor_step(self):
+        """hcu_probe 训推 dump:按当前 micro_batch 顺序从 _pending_request_ids 取 request_id,写 update_actor_log.jsonl。"""
