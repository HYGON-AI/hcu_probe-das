diff --git a/verl/workers/engine/fsdp/transformer_impl.py b/verl/workers/engine/fsdp/transformer_impl.py
index 2c66c6a3..480b426c 100644
--- a/verl/workers/engine/fsdp/transformer_impl.py
+++ b/verl/workers/engine/fsdp/transformer_impl.py
@@ -112,6 +112,9 @@ class FSDPEngine(BaseEngine):
         self.checkpoint_config = checkpoint_config
 
         self.mode = None
+        # hcu_probe 训推一致 dump:占位,debugger 由 _ensure_debugger() 懒加载
+        self._debugger = None
+        self._update_actor_logger_fp = None
 
         self.rank = torch.distributed.get_rank()
 
@@ -637,8 +640,15 @@ class FSDPEngine(BaseEngine):
         # getattr fallback: some subclasses (e.g. VeOmniEngine) bypass FSDPEngine.__init__
         # and _build_fsdp_module, so self.scaler may not be set.
         scaler = getattr(self, "scaler", None)
+        # hcu_probe 训推一致 dump:FSDP forward_backward_batch 有显式 micro_batch 循环,在循环体内包 debugger
+        self._ensure_debugger()
+        dump_phase = os.environ.get("DUMP_PHASE", "log_prob")  # "all" | "log_prob" | "update_actor"
+        phase = "log_prob" if forward_only else "update_actor"
+        should_dump = self._debugger is not None and (dump_phase == "all" or dump_phase == phase)
 
         for micro_batch in micro_batches:
+            if should_dump:
+                self._debugger.start(model=self.module)
             with ctx:
                 loss, meta_info = self.forward_step(micro_batch, loss_function=loss_function, forward_only=forward_only)
 
@@ -648,11 +658,68 @@ class FSDPEngine(BaseEngine):
                     else:
                         loss.backward()
 
+            if should_dump:
+                if not self._debugger.service.should_stop_service:
+                    self._log_update_actor_step(micro_batch)
+                self._debugger.stop()
+                self._debugger.step()
             output_lst.append(meta_info)
 
         # postprocess and return
         return postprocess_batch_func(output_lst=output_lst, indices=indices, data=data)
 
+    def _ensure_debugger(self):
+        """hcu_probe 训推一致 dump:首次 forward_backward_batch 懒初始化 debugger。仅 actor engine 建(ref forward_only 跳)。"""
+        if self._debugger is not None:
+            return
+        if self.engine_config.forward_only:
+            return
+        if not int(os.environ.get("DUMP_ON", 0)):
+            return
+        from pathlib import Path
+
+        from hcuprobe.pytorch import PrecisionDebugger, seed_all
+
+        seed_all(mode=True)
+        self._debugger = PrecisionDebugger(config_path=os.environ.get("DUMP_ACTOR_CONFIG", "/home/config_actor.json"))
+        try:
+            dump_path = self._debugger.config.dump_path
+            log_dir = Path(dump_path) / str(os.getpid())
+            log_dir.mkdir(parents=True, exist_ok=True)
+            self._update_actor_logger_fp = open(log_dir / "update_actor_log.jsonl", "a")
+        except Exception as e:
+            logger.warning(f"Failed to initialize update_actor_logger: {e}")
+
+    def _log_update_actor_step(self, micro_batch):
+        """hcu_probe 训推一致 dump:从 micro_batch 提取 request_id,一行写入 update_actor_log.jsonl。"""
+        if self._update_actor_logger_fp is None:
+            return
+        try:
+            req_data = tu.get(micro_batch, key="request_id", default=None)
+            if not req_data:
+                request_ids = []
+            elif isinstance(req_data, list):
+                request_ids = [str(r) for r in req_data]
+            else:
+                request_ids = [str(req_data)]
+        except Exception:
+            request_ids = []
+
+        import json
+        import time
+
+        record = {
+            "source": "update_actor",
+            "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime()),
+            "pid": os.getpid(),
+            "rank": self.rank,
+            "step": self._debugger.service.current_iter,
+            "request_ids": request_ids,
+            "num_requests": len(request_ids),
+        }
+        self._update_actor_logger_fp.write(json.dumps(record, ensure_ascii=False) + "\n")
+        self._update_actor_logger_fp.flush()
+
     def forward_step(self, micro_batch: TensorDict, loss_function, forward_only):
         raise NotImplementedError("forward_step must be implemented in subclass")
 
